{
  "name": "dsh-plugin-scihub",
  "version": "0.2.0",
  "description": "DeepSeek Harness native plugin: search academic literature across Crossref/OpenAlex/Europe PMC/PubMed/Semantic Scholar/arXiv/DOAJ and download full text — open access first (arXiv, PMC, Europe PMC, Unpaywall, OpenAlex, publisher), then Sci-Hub mirrors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sevastopol36/dsh-plugin-scihub.git"
  },
  "homepage": "https://github.com/sevastopol36/dsh-plugin-scihub#readme",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./lib/*": "./lib/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "verifiedRuntimes": [
        "0.1.5-rc.1",
        "0.2.0-rc.2"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "sci-hub",
    "scihub",
    "academic",
    "paper",
    "literature",
    "pdf",
    "crossref",
    "openalex",
    "pubmed",
    "pmc",
    "europepmc",
    "unpaywall",
    "arxiv",
    "doi",
    "open-access",
    "plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bugs": {
    "url": "https://github.com/sevastopol36/dsh-plugin-scihub/issues"
  }
}
